<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- Session wrapper: content + overlay keyboard (hidden by default) -->
    <LinearLayout
        android:id="@+id/sessionWrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Content area: GeckoView or SSH terminal (fills space above overlay) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- GeckoView content (hidden by default) -->
            <FrameLayout
                android:id="@+id/geckoContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.vscodetunnel.app.SuppressableGeckoView
                    android:id="@+id/geckoView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Cursor dot overlaid on GeckoView -->
                <ImageView
                    android:id="@+id/cursorDot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cursor_dot"
                    android:visibility="gone"
                    android:elevation="10dp" />
            </FrameLayout>

            <!-- SSH Terminal content (hidden by default) -->
            <FrameLayout
                android:id="@+id/sshContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <WebView
                    android:id="@+id/sshTerminalWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <!-- SFTP file browser (hidden by default) -->
            <FrameLayout
                android:id="@+id/sftpContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <WebView
                    android:id="@+id/sftpWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </FrameLayout>

        <!-- Overlay keyboard WebView (shared between VS Code and SSH) -->
        <WebView
            android:id="@+id/overlayWebView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Floating toggle to show overlay (over GeckoView/SSH) -->
    <Button
        android:id="@+id/floatingToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:text="&lt;/&gt;"
        android:textSize="12sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/fab_circle"
        android:elevation="6dp"
        android:visibility="gone" />


    <!-- Launcher UI -->
    <ScrollView
        android:id="@+id/launcherScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp"
            android:paddingTop="48dp">

            <!-- Logo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;/&gt;"
                android:textSize="48sp"
                android:textColor="@color/primary"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS Code Tunnel"
                android:textSize="24sp"
                android:textColor="@color/text_white"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server-side development on Android"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="32dp" />

            <!-- Settings button (top-right feel via horizontal layout) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Check Update"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Update banner (hidden) -->
            <LinearLayout
                android:id="@+id/updateBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/accent_green"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/updateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/updateLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download &amp; Install"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/updateProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:progressTint="@color/text_white"
                    android:progressBackgroundTint="@color/accent_green_dark" />
            </LinearLayout>

            <!-- Active sessions section (hidden) -->
            <LinearLayout
                android:id="@+id/activeSessionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Sessions"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/activeSessionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Error message (hidden) -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#5A1D1D"
                android:textColor="@color/error"
                android:padding="12dp"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- GitHub Login button -->
            <Button
                android:id="@+id/btnGitHubLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sign in with GitHub"
                android:textColor="@color/text_white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:background="@drawable/bg_button_green"
                android:layout_marginBottom="16dp" />

            <!-- Logged-in header (hidden) -->
            <LinearLayout
                android:id="@+id/loggedInHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/usernameText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Device code flow (hidden) -->
            <LinearLayout
                android:id="@+id/deviceCodeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_device_code"
                android:gravity="center_horizontal"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter this code on GitHub:"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/deviceCodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textColor="@color/text_white"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/deviceCodeSpinner"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/primary" />
            </LinearLayout>

            <!-- Tunnel list section (hidden) -->
            <LinearLayout
                android:id="@+id/tunnelSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Tunnels"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRefreshTunnels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tunnelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <ProgressBar
                    android:id="@+id/tunnelSpinner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tunnelEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tunnels found"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- SSH Servers section -->
            <LinearLayout
                android:id="@+id/sshSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SSH Servers"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnKeyGen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Key Gen"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/btnQuickSsh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/btnAddSsh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:padding="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sshServerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/sshEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No saved servers"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:padding="16dp" />
            </LinearLayout>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  or connect manually  "
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />
            </LinearLayout>

            <!-- Manual URL input -->
            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:hint="https://vscode.dev/tunnel/..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Connect"
                android:textColor="@color/text_white"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:background="@drawable/bg_button_blue"
                android:layout_marginBottom="24dp" />

            <!-- Recent connections -->
            <LinearLayout
                android:id="@+id/recentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Debug log section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Debug Log"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnShowLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    android:padding="8dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:visibility="gone"
                android:background="@color/background"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textIsSelectable="true" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
