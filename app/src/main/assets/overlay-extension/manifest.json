{
  "manifest_version": 2,
  "name": "VSCode Tunnel Overlay",
  "version": "1.0",
  "description": "Injects keyboard and touchpad overlay into vscode.dev",
  "browser_specific_settings": {
    "gecko": {
      "id": "overlay@vscodetunnel.app"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "https://auth.vscode.dev/*",
    "https://main.vscode-cdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://vscode.dev/*",
        "*://*.vscode.dev/*",
        "*://insiders.vscode.dev/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "overlay.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
